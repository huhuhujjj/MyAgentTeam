{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": "."
  },
  "include": [
    "src/**/*.js",
    "app.js"
  ],
  "exclude": [
    "node_modules",
    "*.min.js"
  ]
}
